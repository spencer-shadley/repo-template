{
  "schemaId": "https://schemas.repo-template.dev/local-ci-v3/local-ci-contract-v3.schema.json",
  "schemaVersion": "3.0.0",
  "contractId": "repo-template/local-ci-v3",
  "repository": "spencer-shadley/repo-template",
  "canonicalBranch": "master",
  "commands": {
    "authoritative-gate": {
      "name": "verify",
      "executable": "pnpm",
      "args": [
        "verify"
      ],
      "shell": "none",
      "cwd": ".",
      "timeoutSeconds": 3600,
      "expectedExitCode": 0,
      "failureDisposition": "fail-gate",
      "detectionProof": {
        "exempt": "`pnpm verify` is the repository authoritative gate declared in package.json scripts.verify; shell chaining exits non-zero on the first failed step"
      }
    }
  },
  "environment": {
    "runtime": {
      "name": "node",
      "versionConstraint": ">=24.16.0 <25"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0"
    },
    "supportedPlatforms": [
      "win32",
      "linux",
      "darwin"
    ],
    "supportedArchitectures": [
      "x64",
      "arm64"
    ],
    "requiredEnvVars": [],
    "requiredCredentials": [],
    "networkExpectation": "offline-only"
  },
  "effects": {
    "credentialsAccess": false,
    "networkProviderAccess": false,
    "providerSpend": false,
    "externalMutation": false,
    "registrationMutation": false,
    "schedulesMutation": false,
    "deploymentMutation": false,
    "consumerBindingMutation": false,
    "servingAuthorityMutation": false
  },
  "prMergeProfileId": "merge",
  "prBroaderFallback": true,
  "prReceiptBindsCandidate": true,
  "prReceiptBindsBase": true,
  "prReceiptBindsIntegration": true,
  "prReceipt": {
    "bindsCandidate": true,
    "bindsBase": true,
    "bindsIntegration": true
  },
  "fullRequiredLegIds": [
    "default"
  ],
  "simpleDiff": {
    "quality-lint": {
      "paths": [
        "eslint.config.*",
        "eslint.quality.*",
        "eslint-suppressions.json",
        "package.json",
        "pnpm-lock.yaml",
        "package-lock.json",
        "docs/QUALITY-LINT.md",
        "scripts/verify-quality-lint*"
      ],
      "commands": {
        "lint": {
          "executable": "pnpm",
          "args": [
            "lint"
          ],
          "timeoutSeconds": 300,
          "expectedExitCode": 0,
          "failureDisposition": "fail-gate"
        }
      }
    }
  }
}
