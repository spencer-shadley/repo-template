{
  "commands": {
    "authoritative-gate": {
      "executable": "pnpm",
      "args": [
        "verify"
      ],
      "timeoutSeconds": 600,
      "expectedExitCode": 0,
      "failureDisposition": "fail-gate"
    }
  },
  "simpleDiff": {
    "quality-lint": {
      "paths": [
        "eslint.config.*",
        "eslint.quality.*",
        "eslint-suppressions.json",
        "package.json",
        "pnpm-lock.yaml",
        "package-lock.json",
        "CHANGELOG.md",
        "docs/QUALITY-LINT.md",
        "local-ci.json",
        "packages/repo-quality/secret-scan.mjs",
        "scripts/verify-quality-lint*"
      ],
      "commands": {
        "lint": {
          "executable": "pnpm",
          "args": [
            "lint"
          ],
          "timeoutSeconds": 300,
          "expectedExitCode": 0,
          "failureDisposition": "fail-gate"
        }
      }
    }
  }
}
