{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-template.dev/test-harness/v1/test-harness.schema.json",
  "title": "TestHarnessProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "contractId",
    "profileId",
    "framework",
    "configPath",
    "smokeTestPath"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaId": {
      "const": "https://schemas.repo-template.dev/test-harness/v1/test-harness.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "contractId": {
      "const": "repo-template/test-harness/v1"
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "framework": {
      "type": "string",
      "enum": [
        "vitest"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "typescript",
        "javascript"
      ]
    },
    "configPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "smokeTestPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "vitestVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "declaredScripts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_:-]+$"
      }
    }
  }
}
