{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spencer-shadley.github.io/repo-template/contracts/plan-record/v1/work-migration-manifest.schema.json",
  "title": "WorkMigrationManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "schemaRelease", "decisions", "archive", "changedPaths", "verification", "canary", "rollbackRef", "unclassifiedCount", "manifestSha256"],
  "properties": {
    "schemaVersion": { "const": "work-migration-manifest/v1" },
    "source": { "$ref": "#/$defs/gitSource" },
    "schemaRelease": { "type": "object", "additionalProperties": false, "required": ["version", "digest"], "properties": { "version": { "const": "3.0.0" }, "digest": { "$ref": "#/$defs/sha256" } } },
    "decisions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "decision", "reasonCode"], "properties": { "path": { "type": "string", "minLength": 1 }, "decision": { "enum": ["migrate", "retire"] }, "reasonCode": { "enum": ["LEGACY_READY", "LEGACY_ACTIVE", "LEGACY_TERMINAL", "LEGACY_HELD_COMPLETE", "AMBIGUOUS_STATUS", "INVALID_V1", "UNCLASSIFIED_INPUT"] } } } },
    "archive": { "type": "object", "additionalProperties": false, "required": ["count", "aggregateSha256"], "properties": { "count": { "type": "integer", "minimum": 0 }, "aggregateSha256": { "$ref": "#/$defs/sha256" } } },
    "changedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "verification": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "canary": { "type": "object", "additionalProperties": false, "required": ["repository", "state"], "properties": { "repository": { "const": "gmail-markdown" }, "state": { "enum": ["pending", "green", "red"] } } },
    "rollbackRef": { "type": "string", "minLength": 1 },
    "unclassifiedCount": { "const": 0 },
    "manifestSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSource": { "type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": { "commit": { "$ref": "#/$defs/sha256" }, "tree": { "$ref": "#/$defs/sha256" } } }
  }
}
