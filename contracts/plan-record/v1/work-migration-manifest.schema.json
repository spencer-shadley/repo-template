{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spencer-shadley.github.io/repo-template/contracts/plan-record/v1/work-migration-manifest.schema.json",
  "title": "WorkMigrationManifestV1",
  "$comment": "This Draft 2020-12 schema validates portable structure only. Full semantic admission MUST also pass validateWorkMigrationManifestV1 from the exact released TypeScript or generated artifact; bare JSON Schema validation cannot prove decisions-to-changedPaths projection equality, unique archive member paths, count closure, or digest recomputation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "schemaRelease", "decisions", "liveCounts", "archive", "changedPaths", "verification", "canary", "rollbackRef", "unclassifiedCount", "manifestSha256"],
  "properties": {
    "schemaVersion": { "const": "work-migration-manifest/v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitObjectId" },
        "tree": { "$ref": "#/$defs/gitObjectId" }
      }
    },
    "schemaRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": { "const": "3.0.0" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "liveCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "migrate", "retire", "after"],
      "properties": {
        "before": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "migrate": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "retire": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "after": { "$ref": "#/$defs/nonnegativeSafeInteger" }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "count", "aggregateAlgorithm", "aggregateSha256", "members", "dispositions"],
      "properties": {
        "repository": { "$ref": "#/$defs/repository" },
        "count": { "$ref": "#/$defs/nonnegativeSafeInteger" },
        "aggregateAlgorithm": { "const": "sha256-framed-path-blob-sha256hex-v1" },
        "aggregateSha256": { "$ref": "#/$defs/sha256" },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/archiveMember" }
        },
        "dispositions": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "reasonCode", "count", "aggregateSha256"],
            "properties": {
              "decision": { "const": "archive-receipt-only" },
              "reasonCode": { "const": "ARCHIVE_SEALED" },
              "count": { "$ref": "#/$defs/positiveSafeInteger" },
              "aggregateSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "count": { "const": 0 } }, "required": ["count"] },
          "then": {
            "properties": {
              "members": { "maxItems": 0 },
              "dispositions": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "members": { "minItems": 1 },
              "dispositions": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "changedPaths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/planPath" } },
    "verification": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlank" } },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "state"],
      "properties": {
        "repository": { "const": "gmail-markdown" },
        "state": { "enum": ["pending", "green", "red"] }
      }
    },
    "rollbackRef": { "$ref": "#/$defs/nonBlank" },
    "unclassifiedCount": { "const": 0 },
    "manifestSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nonnegativeSafeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positiveSafeInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObjectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))(?!.*(?:^|/)[^/]*\\.(?:/|$))(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[A-Za-z0-9._@()+,=-]+(?:/[A-Za-z0-9._@()+,=-]+)*$"
    },
    "planBodyPath": {
      "allOf": [
        { "$ref": "#/$defs/path" },
        {
          "pattern": "^plans/(?:archive/)?(?![^/]*\\.(?:[Ll][Oo][Gg]|[Rr][Ee][Ss][Uu][Ll][Tt]|[Cc][Rr][Ii][Tt][Ii][Cc]|[Ff][Ee][Ee][Dd][Bb][Aa][Cc][Kk]|[Dd][Ee][Aa][Dd][Ll][Ee][Tt][Tt][Ee][Rr])\\.md$)[0-9]{3,}-[A-Za-z0-9._@()+,=-]+\\.md$"
        }
      ]
    },
    "planPath": {
      "allOf": [
        { "$ref": "#/$defs/planBodyPath" },
        { "pattern": "^plans/[0-9]{3,}-" }
      ]
    },
    "archivePlanPath": {
      "allOf": [
        { "$ref": "#/$defs/planBodyPath" },
        { "pattern": "^plans/archive/[0-9]{3,}-" }
      ]
    },
    "archiveMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blobSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/archivePlanPath" },
        "blobSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "decision", "targetStatus", "reasonCode"],
          "properties": {
            "path": { "$ref": "#/$defs/planPath" },
            "decision": { "const": "migrate" },
            "targetStatus": { "const": "planned" },
            "reasonCode": { "const": "LEGACY_READY" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "decision", "targetStatus", "reasonCode"],
          "properties": {
            "path": { "$ref": "#/$defs/planPath" },
            "decision": { "const": "migrate" },
            "targetStatus": { "const": "in-progress" },
            "reasonCode": { "const": "LEGACY_ACTIVE" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "decision", "targetStatus", "reasonCode"],
          "properties": {
            "path": { "$ref": "#/$defs/planPath" },
            "decision": { "const": "migrate" },
            "targetStatus": { "const": "implemented" },
            "reasonCode": { "const": "LEGACY_IMPLEMENTED" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "decision", "targetStatus", "reasonCode"],
          "properties": {
            "path": { "$ref": "#/$defs/planPath" },
            "decision": { "const": "migrate" },
            "targetStatus": { "const": "closed" },
            "reasonCode": { "const": "LEGACY_CLOSED" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "decision", "targetStatus", "reasonCode"],
          "properties": {
            "path": { "$ref": "#/$defs/planPath" },
            "decision": { "const": "migrate" },
            "targetStatus": { "const": "held-authority" },
            "reasonCode": { "const": "LEGACY_HELD_COMPLETE" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "decision", "reasonCode"],
          "properties": {
            "path": { "$ref": "#/$defs/planPath" },
            "decision": { "const": "retire" },
            "reasonCode": { "enum": ["INCOMPLETE_EVIDENCE", "AMBIGUOUS_STATUS", "INVALID_V1", "UNKNOWN_SCHEMA_VERSION", "UNCLASSIFIED_INPUT"] }
          }
        }
      ]
    }
  }
}
