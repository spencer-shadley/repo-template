{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spencer-shadley.github.io/repo-template/contracts/plan-record/v1/plan-record.schema.json",
  "title": "PlanRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "repository", "planNumber", "title", "sourcePath", "status", "issue", "enqueuedAt", "enqueueTimeSource", "risk"],
  "properties": {
    "schemaVersion": { "const": "plan-record/v1" },
    "project": { "type": "string", "minLength": 1 },
    "repository": { "$ref": "#/$defs/repository" },
    "planNumber": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1 },
    "sourcePath": { "$ref": "#/$defs/planPath" },
    "status": { "enum": ["planned", "in-progress", "implemented", "closed", "held-authority"] },
    "issue": { "$ref": "#/$defs/issue" },
    "enqueuedAt": { "type": "string", "format": "date-time" },
    "enqueueTimeSource": { "enum": ["recorded", "file-add-backfill"] },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "rationale", "effectClasses"],
      "properties": {
        "tier": { "enum": ["auto", "human"] },
        "rationale": { "type": "string", "minLength": 1 },
        "effectClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "owner": { "type": "string", "minLength": 1 },
    "trigger": { "type": "string", "minLength": 1 },
    "retryReason": { "type": "string", "minLength": 1 },
    "supersededBy": { "$ref": "#/$defs/planReference" },
    "disposition": { "enum": ["completed", "duplicate", "not-planned", "invalid"] },
    "receipt": { "$ref": "#/$defs/receipt" },
    "contractSnapshots": { "$ref": "#/$defs/snapshots" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "planned" } }, "required": ["status"] },
      "then": { "not": { "anyOf": [{ "required": ["contractSnapshots"] }, { "required": ["receipt"] }, { "required": ["disposition"] }, { "required": ["supersededBy"] }] } }
    },
    {
      "if": { "properties": { "status": { "const": "in-progress" } }, "required": ["status"] },
      "then": {
        "required": ["contractSnapshots"],
        "properties": { "contractSnapshots": { "not": { "required": ["land"] } } },
        "not": { "anyOf": [{ "required": ["receipt"] }, { "required": ["disposition"] }, { "required": ["supersededBy"] }] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "implemented" } }, "required": ["status"] },
      "then": {
        "required": ["contractSnapshots", "receipt"],
        "properties": {
          "contractSnapshots": { "required": ["claim", "land"] },
          "receipt": {
            "properties": { "kind": { "const": "landed" } },
            "not": { "required": ["deployedAt"] }
          }
        },
        "not": { "anyOf": [{ "required": ["disposition"] }, { "required": ["supersededBy"] }] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "closed" } }, "required": ["status"] },
      "then": {
        "required": ["disposition"],
        "allOf": [
          {
            "if": { "properties": { "disposition": { "const": "completed" } }, "required": ["disposition"] },
            "then": {
              "required": ["contractSnapshots", "receipt"],
              "properties": {
                "contractSnapshots": { "required": ["claim", "land"] },
                "receipt": {
                  "required": ["kind", "commit", "deployedAt"],
                  "properties": { "kind": { "const": "deployed" } }
                }
              },
              "not": { "required": ["supersededBy"] }
            },
            "else": {
              "not": { "required": ["receipt"] },
              "properties": { "contractSnapshots": { "not": { "required": ["land"] } } }
            }
          },
          {
            "if": { "properties": { "disposition": { "const": "duplicate" } }, "required": ["disposition"] },
            "else": { "not": { "required": ["supersededBy"] } }
          }
        ]
      }
    },
    {
      "if": { "properties": { "status": { "const": "held-authority" } }, "required": ["status"] },
      "then": {
        "required": ["trigger"],
        "properties": { "contractSnapshots": { "not": { "required": ["land"] } } },
        "not": { "anyOf": [{ "required": ["receipt"] }, { "required": ["disposition"] }, { "required": ["supersededBy"] }] }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObjectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "planPath": { "type": "string", "maxLength": 240, "pattern": "^plans/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[A-Za-z0-9._@()+,=-]+(?:/[A-Za-z0-9._@()+,=-]+)*\\.md$" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim"],
      "properties": {
        "claim": { "$ref": "#/$defs/snapshot" },
        "land": { "$ref": "#/$defs/snapshot" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "commit"],
      "properties": {
        "kind": { "enum": ["landed", "deployed"] },
        "commit": { "$ref": "#/$defs/gitObjectId" },
        "deployedAt": { "type": "string", "format": "date-time" }
      }
    },
    "planReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "planNumber"],
      "properties": {
        "repository": { "$ref": "#/$defs/repository" },
        "planNumber": { "type": "integer", "minimum": 0 }
      }
    },
    "issue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "number"],
          "properties": {
            "kind": { "const": "github" },
            "repository": { "$ref": "#/$defs/repository" },
            "number": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "planNumber"],
          "properties": {
            "kind": { "const": "plan-host" },
            "repository": { "$ref": "#/$defs/repository" },
            "planNumber": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  }
}
