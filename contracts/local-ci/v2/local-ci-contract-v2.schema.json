{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-template.dev/local-ci-v2/local-ci-contract-v2.schema.json",
  "title": "LocalCiContractV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "contractId",
    "repository",
    "canonicalBranch",
    "commands",
    "environment",
    "effects"
  ],
  "properties": {
    "schemaId": {
      "const": "https://schemas.repo-template.dev/local-ci-v2/local-ci-contract-v2.schema.json"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "contractId": {
      "const": "repo-template/local-ci-v2"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]+/[^/]+$"
    },
    "canonicalBranch": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "executable",
          "args",
          "shell",
          "cwd",
          "timeoutSeconds",
          "order",
          "expectedExitCode",
          "isAuthoritativeGate",
          "failureDisposition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shell": {
            "enum": ["pwsh", "cmd", "bash", "sh", "none"]
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "expectedExitCode": {
            "type": "integer"
          },
          "isAuthoritativeGate": {
            "type": "boolean"
          },
          "failureDisposition": {
            "enum": ["fail-gate", "warning", "non-routable"]
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "packageManager",
        "supportedPlatforms",
        "supportedArchitectures",
        "requiredEnvVars",
        "requiredCredentials",
        "networkExpectation"
      ],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "versionConstraint"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "versionConstraint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "packageManager": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "supportedPlatforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supportedArchitectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredEnvVars": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredCredentials": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "networkExpectation": {
          "enum": ["offline-only", "local-loopback", "outbound-allowed"]
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialsAccess",
        "networkProviderAccess",
        "providerSpend",
        "externalMutation",
        "registrationMutation",
        "schedulesMutation",
        "deploymentMutation",
        "consumerBindingMutation",
        "servingAuthorityMutation"
      ],
      "properties": {
        "credentialsAccess": {
          "type": "boolean"
        },
        "networkProviderAccess": {
          "type": "boolean"
        },
        "providerSpend": {
          "type": "boolean"
        },
        "externalMutation": {
          "type": "boolean"
        },
        "registrationMutation": {
          "type": "boolean"
        },
        "schedulesMutation": {
          "type": "boolean"
        },
        "deploymentMutation": {
          "type": "boolean"
        },
        "consumerBindingMutation": {
          "type": "boolean"
        },
        "servingAuthorityMutation": {
          "type": "boolean"
        }
      }
    }
  }
}
