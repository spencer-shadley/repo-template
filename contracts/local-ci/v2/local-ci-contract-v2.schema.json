{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-template.dev/local-ci-v2/local-ci-contract-v2.schema.json",
  "title": "LocalCiContractV2",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "executable",
        "args",
        "shell",
        "cwd",
        "timeoutSeconds",
        "expectedExitCode",
        "failureDisposition"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shell": {
          "enum": ["pwsh", "cmd", "bash", "sh", "none"]
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "expectedExitCode": {
          "type": "integer"
        },
        "failureDisposition": {
          "enum": ["fail-gate", "warning", "non-routable"]
        }
      }
    }
  },
  "required": [
    "schemaId",
    "schemaVersion",
    "contractId",
    "repository",
    "canonicalBranch",
    "commands",
    "environment",
    "effects"
  ],
  "properties": {
    "schemaId": {
      "const": "https://schemas.repo-template.dev/local-ci-v2/local-ci-contract-v2.schema.json"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "contractId": {
      "const": "repo-template/local-ci-v2"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]+/[^/]+$"
    },
    "canonicalBranch": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": false,
      "required": ["authoritative-gate"],
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "properties": {
        "authoritative-gate": {
          "$ref": "#/$defs/command"
        }
      },
      "patternProperties": {
        "^(?!authoritative-gate$)[a-zA-Z0-9_-]+$": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "packageManager",
        "supportedPlatforms",
        "supportedArchitectures",
        "requiredEnvVars",
        "requiredCredentials",
        "networkExpectation"
      ],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "versionConstraint"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "versionConstraint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "packageManager": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "supportedPlatforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supportedArchitectures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredEnvVars": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredCredentials": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "networkExpectation": {
          "enum": ["offline-only", "local-loopback", "outbound-allowed"]
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialsAccess",
        "networkProviderAccess",
        "providerSpend",
        "externalMutation",
        "registrationMutation",
        "schedulesMutation",
        "deploymentMutation",
        "consumerBindingMutation",
        "servingAuthorityMutation"
      ],
      "properties": {
        "credentialsAccess": {
          "type": "boolean"
        },
        "networkProviderAccess": {
          "type": "boolean"
        },
        "providerSpend": {
          "type": "boolean"
        },
        "externalMutation": {
          "type": "boolean"
        },
        "registrationMutation": {
          "type": "boolean"
        },
        "schedulesMutation": {
          "type": "boolean"
        },
        "deploymentMutation": {
          "type": "boolean"
        },
        "consumerBindingMutation": {
          "type": "boolean"
        },
        "servingAuthorityMutation": {
          "type": "boolean"
        }
      }
    }
  }
}
