{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-template.dev/local-ci-v3/post-publication-readback-receipt.schema.json",
  "title": "LocalCiContractV3 post-publication readback receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "contractId",
    "receiptKind",
    "receiptId",
    "publicationState",
    "programmeEpic",
    "issue",
    "producerFreezeIssue",
    "producerCandidateReceiptId",
    "producerCandidateReceiptDigest",
    "candidate",
    "lineage",
    "canaryReceipts",
    "publishedReleaseReceipt",
    "canonicalDigests",
    "manifestDigests",
    "proofOfDetectionSemantics",
    "verification",
    "readback",
    "rollback",
    "publicationTime",
    "digestAlgorithm",
    "receiptDigest"
  ],
  "properties": {
    "schemaId": {
      "const": "https://schemas.repo-template.dev/local-ci-v3/post-publication-readback-receipt.schema.json"
    },
    "schemaVersion": {
      "const": "3.0.0"
    },
    "contractId": {
      "const": "repo-template/local-ci-v3-post-publication-readback"
    },
    "receiptKind": {
      "const": "repo-template/local-ci-v3-readback-receipt/v1"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^receipt-issue-341-[a-z0-9]+$"
    },
    "publicationState": {
      "const": "published"
    },
    "programmeEpic": {
      "const": "https://github.com/spencer-shadley/repo-template/issues/102"
    },
    "issue": {
      "const": "https://github.com/spencer-shadley/repo-template/issues/341"
    },
    "producerFreezeIssue": {
      "const": "https://github.com/spencer-shadley/repo-template/issues/340"
    },
    "producerCandidateReceiptId": {
      "type": "string"
    },
    "producerCandidateReceiptDigest": {
      "$ref": "#/$defs/sha256"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "origin",
        "semver",
        "tag",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "const": "spencer-shadley/repo-template"
        },
        "origin": {
          "const": "https://github.com/spencer-shadley/repo-template.git"
        },
        "semver": {
          "$ref": "#/$defs/semver"
        },
        "tag": {
          "type": "string",
          "pattern": "^v"
        },
        "commit": {
          "$ref": "#/$defs/gitSha1"
        },
        "tree": {
          "$ref": "#/$defs/gitSha1"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "schemaVersion",
        "outcomeContractId",
        "outcomeSchemaVersion",
        "proofOfDetectionRequired",
        "establishedBy",
        "establishedPr",
        "decisionRecord"
      ],
      "properties": {
        "contractId": {
          "const": "repo-template/local-ci-v3"
        },
        "schemaVersion": {
          "const": "3.0.0"
        },
        "outcomeContractId": {
          "const": "repo-template/local-ci-outcome-v1"
        },
        "outcomeSchemaVersion": {
          "const": "1.0.0"
        },
        "proofOfDetectionRequired": {
          "const": true
        },
        "establishedBy": {
          "const": "https://github.com/spencer-shadley/repo-template/issues/131"
        },
        "establishedPr": {
          "const": "https://github.com/spencer-shadley/repo-template/pull/132"
        },
        "decisionRecord": {
          "const": "docs/adr/0009-local-ci-contract-v3-proof-of-detection.md"
        }
      }
    },
    "canaryReceipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelGateway",
        "repoFactory"
      ],
      "properties": {
        "modelGateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issue",
            "receiptId",
            "receiptKind",
            "receiptDigest",
            "receiptUrl",
            "consumerRepository",
            "consumerRole",
            "targetLineage",
            "verifiedOutcomes",
            "noUnclaimedEffects",
            "candidateDigestMatches"
          ],
          "properties": {
            "issue": { "type": "string" },
            "receiptId": { "type": "string" },
            "receiptKind": { "type": "string" },
            "receiptDigest": { "$ref": "#/$defs/sha256" },
            "receiptUrl": { "type": "string" },
            "consumerRepository": { "type": "string" },
            "consumerRole": { "type": "string" },
            "targetLineage": { "type": "string" },
            "verifiedOutcomes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "noUnclaimedEffects": { "const": true },
            "candidateDigestMatches": { "const": true }
          }
        },
        "repoFactory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issue",
            "receiptId",
            "receiptKind",
            "receiptDigest",
            "receiptUrl",
            "consumerRepository",
            "consumerRole",
            "targetLineage",
            "verifiedOutcomes",
            "noUnclaimedEffects",
            "candidateDigestMatches"
          ],
          "properties": {
            "issue": { "type": "string" },
            "receiptId": { "type": "string" },
            "receiptKind": { "type": "string" },
            "receiptDigest": { "$ref": "#/$defs/sha256" },
            "receiptUrl": { "type": "string" },
            "consumerRepository": { "type": "string" },
            "consumerRole": { "type": "string" },
            "targetLineage": { "type": "string" },
            "verifiedOutcomes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "noUnclaimedEffects": { "const": true },
            "candidateDigestMatches": { "const": true }
          }
        }
      }
    },
    "publishedReleaseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "schemaDigest",
        "contractId",
        "receiptKind",
        "publicationState",
        "releaseId",
        "receiptDigestAlgorithm",
        "receiptDigest",
        "producer",
        "receiptTransport",
        "payloadSet",
        "capabilityBundles",
        "materializer",
        "migrationRefs"
      ],
      "properties": {
        "schemaId": {
          "const": "https://schemas.repo-template.dev/adoption-shell-v2/template-release-receipt.schema.json"
        },
        "schemaVersion": {
          "const": "2.0.0"
        },
        "schemaDigest": {
          "$ref": "#/$defs/sha256"
        },
        "contractId": {
          "const": "repo-template/adoption-shell-v2"
        },
        "receiptKind": {
          "const": "repo-template/release-receipt/v1"
        },
        "publicationState": {
          "const": "published"
        },
        "releaseId": {
          "type": "string",
          "minLength": 34,
          "maxLength": 120,
          "pattern": "^spencer-shadley/repo-template@"
        },
        "receiptDigestAlgorithm": {
          "const": "sha256-rfc8785-v1"
        },
        "receiptDigest": {
          "$ref": "#/$defs/sha256"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "origin",
            "semver",
            "tag",
            "commit",
            "tree"
          ],
          "properties": {
            "repository": {
              "const": "spencer-shadley/repo-template"
            },
            "origin": {
              "const": "https://github.com/spencer-shadley/repo-template.git"
            },
            "semver": {
              "$ref": "#/$defs/semver"
            },
            "tag": {
              "type": "string",
              "minLength": 6,
              "maxLength": 81,
              "pattern": "^v"
            },
            "commit": {
              "$ref": "#/$defs/gitSha1"
            },
            "tree": {
              "$ref": "#/$defs/gitSha1"
            }
          }
        },
        "receiptTransport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tagName",
            "targetObjectType",
            "bodyEncoding",
            "bodyCanonicalization"
          ],
          "properties": {
            "kind": {
              "const": "annotated-git-tag-message/v1"
            },
            "tagName": {
              "type": "string",
              "minLength": 6,
              "maxLength": 81,
              "pattern": "^v"
            },
            "targetObjectType": {
              "const": "commit"
            },
            "bodyEncoding": {
              "const": "utf-8"
            },
            "bodyCanonicalization": {
              "const": "rfc8785"
            }
          }
        },
        "payloadSet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifestPath",
            "schemaId",
            "schemaVersion",
            "schemaDigest",
            "manifestDigest",
            "payloadDigestAlgorithm",
            "payloadDigest",
            "entryCount"
          ],
          "properties": {
            "manifestPath": {
              "const": "release/release-payload-set.json"
            },
            "schemaId": {
              "const": "https://schemas.repo-template.dev/adoption-shell-v2/release-payload-set.schema.json"
            },
            "schemaVersion": {
              "const": "2.0.0"
            },
            "schemaDigest": {
              "$ref": "#/$defs/sha256"
            },
            "manifestDigest": {
              "$ref": "#/$defs/sha256"
            },
            "payloadDigestAlgorithm": {
              "const": "sha256-framed-path-kind-mode-content-v1"
            },
            "payloadDigest": {
              "$ref": "#/$defs/sha256"
            },
            "entryCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        },
        "capabilityBundles": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "digest"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128
              },
              "version": {
                "$ref": "#/$defs/semver"
              },
              "digest": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "materializer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractId",
            "contractVersion",
            "artifactManifestPath",
            "artifactManifestSchemaId",
            "artifactManifestSchemaVersion",
            "artifactManifestSchemaDigest",
            "artifactManifestDigest",
            "artifactDigest",
            "entrypoint",
            "validatorExport",
            "runtimeCompatibility",
            "compatibleReleaseReceiptKind"
          ],
          "properties": {
            "contractId": {
              "const": "repo-template/adoption-shell-v2"
            },
            "contractVersion": {
              "const": "2.0.0"
            },
            "artifactManifestPath": {
              "const": "artifacts/adoption-shell-v2/artifact-manifest.json"
            },
            "artifactManifestSchemaId": {
              "const": "https://schemas.repo-template.dev/adoption-shell-v2/artifact-manifest.schema.json"
            },
            "artifactManifestSchemaVersion": {
              "const": "2.0.0"
            },
            "artifactManifestSchemaDigest": {
              "$ref": "#/$defs/sha256"
            },
            "artifactManifestDigest": {
              "$ref": "#/$defs/sha256"
            },
            "artifactDigest": {
              "$ref": "#/$defs/sha256"
            },
            "entrypoint": {
              "const": "index.js"
            },
            "validatorExport": {
              "const": "validateMaterializerInputV2"
            },
            "runtimeCompatibility": {
              "const": ">=24.16.0 <25"
            },
            "compatibleReleaseReceiptKind": {
              "const": "repo-template/release-receipt/v1"
            }
          }
        },
        "releaseEvidence": {
          "type": "object"
        },
        "migrationRefs": {
          "type": "array"
        }
      }
    },
    "canonicalDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "manifestDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releasePayloadSet",
        "artifactManifest",
        "capabilityBundleRegistry"
      ],
      "properties": {
        "releasePayloadSet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "manifestDigest",
            "payloadDigestAlgorithm",
            "payloadDigest",
            "entryCount"
          ],
          "properties": {
            "path": { "type": "string" },
            "manifestDigest": { "$ref": "#/$defs/sha256" },
            "payloadDigestAlgorithm": { "type": "string" },
            "payloadDigest": { "$ref": "#/$defs/sha256" },
            "entryCount": { "type": "integer", "minimum": 1 }
          }
        },
        "artifactManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "manifestDigest",
            "artifactDigestAlgorithm",
            "artifactDigest"
          ],
          "properties": {
            "path": { "type": "string" },
            "manifestDigest": { "$ref": "#/$defs/sha256" },
            "artifactDigestAlgorithm": { "type": "string" },
            "artifactDigest": { "$ref": "#/$defs/sha256" }
          }
        },
        "capabilityBundleRegistry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "registryDigest",
            "bundles"
          ],
          "properties": {
            "path": { "type": "string" },
            "registryDigest": { "$ref": "#/$defs/sha256" },
            "bundles": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["version", "digest"],
                "properties": {
                  "version": { "$ref": "#/$defs/semver" },
                  "digest": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        }
      }
    },
    "proofOfDetectionSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "outcomeStates",
        "outcomeInvariants",
        "migrationRule",
        "metaGate"
      ],
      "properties": {
        "rule": { "type": "string" },
        "outcomeStates": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 4,
          "maxItems": 4
        },
        "outcomeInvariants": {
          "type": "array",
          "items": { "type": "string" }
        },
        "migrationRule": { "type": "string" },
        "metaGate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entrypoint",
            "crashSafetyLedger",
            "selfTest"
          ],
          "properties": {
            "entrypoint": { "type": "string" },
            "crashSafetyLedger": { "type": "string" },
            "selfTest": { "type": "string" }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryVerification",
        "checks"
      ],
      "properties": {
        "repositoryVerification": {
          "const": "green"
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "result"],
            "properties": {
              "command": { "type": "string" },
              "result": { "const": "passed" }
            }
          }
        }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseAuthority",
        "releaseId",
        "tagName",
        "resolvedCommit",
        "resolvedTree",
        "candidateCommitMatches",
        "candidateTreeMatches",
        "allCanonicalDigestsMatch",
        "firstCanaryAgrees",
        "secondCanaryAgrees",
        "readbackTimestamp"
      ],
      "properties": {
        "releaseAuthority": { "const": "repo-template/release-receipt/v1" },
        "releaseId": { "type": "string" },
        "tagName": { "type": "string" },
        "resolvedCommit": { "$ref": "#/$defs/gitSha1" },
        "resolvedTree": { "$ref": "#/$defs/gitSha1" },
        "candidateCommitMatches": { "const": true },
        "candidateTreeMatches": { "const": true },
        "allCanonicalDigestsMatch": { "const": true },
        "firstCanaryAgrees": { "const": true },
        "secondCanaryAgrees": { "const": true },
        "readbackTimestamp": { "type": "string" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "supersession",
        "rollbackRef"
      ],
      "properties": {
        "disposition": { "const": "immutable-correct-forward" },
        "supersession": { "const": "new-semver-only" },
        "rollbackRef": { "$ref": "#/$defs/gitSha1" }
      }
    },
    "publicationTime": {
      "type": "string"
    },
    "digestAlgorithm": {
      "const": "sha256-rfc8785-v1"
    },
    "receiptDigest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "semver": {
      "type": "string",
      "minLength": 5,
      "maxLength": 80,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
