{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-template.dev/local-ci-v3/canary-candidate-receipt.schema.json",
  "title": "LocalCiContractV3 canary candidate and pre-publication acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "contractId",
    "receiptKind",
    "receiptId",
    "publicationState",
    "programmeEpic",
    "issue",
    "candidate",
    "treeVerification",
    "lineage",
    "candidateReleaseReceipt",
    "canonicalDigests",
    "manifestDigests",
    "proofOfDetectionSemantics",
    "verification",
    "canaryGuidance",
    "digestAlgorithm",
    "receiptDigest"
  ],
  "properties": {
    "schemaId": {
      "const": "https://schemas.repo-template.dev/local-ci-v3/canary-candidate-receipt.schema.json"
    },
    "schemaVersion": {
      "const": "3.0.0"
    },
    "contractId": {
      "const": "repo-template/local-ci-v3-canary-candidate"
    },
    "receiptKind": {
      "const": "repo-template/local-ci-v3-candidate-receipt/v1"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^receipt-issue-340-[a-z0-9]+$"
    },
    "publicationState": {
      "const": "candidate"
    },
    "programmeEpic": {
      "const": "https://github.com/spencer-shadley/repo-template/issues/102"
    },
    "issue": {
      "const": "https://github.com/spencer-shadley/repo-template/issues/340"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "origin",
        "semver",
        "tag",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "const": "spencer-shadley/repo-template"
        },
        "origin": {
          "const": "https://github.com/spencer-shadley/repo-template.git"
        },
        "semver": {
          "$ref": "#/$defs/semver"
        },
        "tag": {
          "type": "string",
          "pattern": "^v"
        },
        "commit": {
          "$ref": "#/$defs/gitSha1"
        },
        "tree": {
          "$ref": "#/$defs/gitSha1"
        }
      }
    },
    "treeVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "resolvedTree", "matches"],
      "properties": {
        "method": {
          "const": "git rev-parse <commit>^{tree}"
        },
        "resolvedTree": {
          "$ref": "#/$defs/gitSha1"
        },
        "matches": {
          "const": true
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "schemaVersion",
        "outcomeContractId",
        "outcomeSchemaVersion",
        "proofOfDetectionRequired",
        "establishedBy",
        "establishedPr",
        "decisionRecord"
      ],
      "properties": {
        "contractId": {
          "const": "repo-template/local-ci-v3"
        },
        "schemaVersion": {
          "const": "3.0.0"
        },
        "outcomeContractId": {
          "const": "repo-template/local-ci-outcome-v1"
        },
        "outcomeSchemaVersion": {
          "const": "1.0.0"
        },
        "proofOfDetectionRequired": {
          "const": true
        },
        "establishedBy": {
          "const": "https://github.com/spencer-shadley/repo-template/issues/131"
        },
        "establishedPr": {
          "const": "https://github.com/spencer-shadley/repo-template/pull/132"
        },
        "decisionRecord": {
          "const": "docs/adr/0009-local-ci-contract-v3-proof-of-detection.md"
        }
      }
    },
    "candidateReleaseReceipt": {
      "type": "object"
    },
    "canonicalDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "manifestDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releasePayloadSet",
        "artifactManifest",
        "capabilityBundleRegistry"
      ],
      "properties": {
        "releasePayloadSet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "manifestDigest",
            "payloadDigestAlgorithm",
            "payloadDigest",
            "entryCount"
          ],
          "properties": {
            "path": { "type": "string" },
            "manifestDigest": { "$ref": "#/$defs/sha256" },
            "payloadDigestAlgorithm": { "type": "string" },
            "payloadDigest": { "$ref": "#/$defs/sha256" },
            "entryCount": { "type": "integer", "minimum": 1 }
          }
        },
        "artifactManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "manifestDigest",
            "artifactDigestAlgorithm",
            "artifactDigest"
          ],
          "properties": {
            "path": { "type": "string" },
            "manifestDigest": { "$ref": "#/$defs/sha256" },
            "artifactDigestAlgorithm": { "type": "string" },
            "artifactDigest": { "$ref": "#/$defs/sha256" }
          }
        },
        "capabilityBundleRegistry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "registryDigest",
            "bundles"
          ],
          "properties": {
            "path": { "type": "string" },
            "registryDigest": { "$ref": "#/$defs/sha256" },
            "bundles": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["version", "digest"],
                "properties": {
                  "version": { "$ref": "#/$defs/semver" },
                  "digest": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        }
      }
    },
    "proofOfDetectionSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "outcomeStates",
        "outcomeInvariants",
        "migrationRule",
        "metaGate"
      ],
      "properties": {
        "rule": { "type": "string" },
        "outcomeStates": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 4,
          "maxItems": 4
        },
        "outcomeInvariants": {
          "type": "array",
          "items": { "type": "string" }
        },
        "migrationRule": { "type": "string" },
        "metaGate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entrypoint",
            "crashSafetyLedger",
            "selfTest"
          ],
          "properties": {
            "entrypoint": { "type": "string" },
            "crashSafetyLedger": { "type": "string" },
            "selfTest": { "type": "string" }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryVerification",
        "evidenceBoundCommit",
        "evidencePath",
        "checks"
      ],
      "properties": {
        "repositoryVerification": {
          "const": "green"
        },
        "evidenceBoundCommit": {
          "$ref": "#/$defs/gitSha1"
        },
        "evidencePath": {
          "type": "string"
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "result", "exitCode", "startedAt", "finishedAt"],
            "properties": {
              "command": { "type": "string" },
              "result": { "const": "passed" },
              "exitCode": { "const": 0 },
              "startedAt": { "type": "string" },
              "finishedAt": { "type": "string" }
            }
          }
        }
      }
    },
    "canaryGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelGateway",
        "repoFactory",
        "convergence"
      ],
      "properties": {
        "modelGateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issue",
            "role",
            "targetLineage",
            "instruction",
            "requiredOutcomes"
          ],
          "properties": {
            "issue": { "type": "string" },
            "role": { "type": "string" },
            "targetLineage": { "type": "string" },
            "instruction": { "type": "string" },
            "requiredOutcomes": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "repoFactory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issue",
            "role",
            "targetLineage",
            "instruction",
            "dependencyBarrier"
          ],
          "properties": {
            "issue": { "type": "string" },
            "role": { "type": "string" },
            "targetLineage": { "type": "string" },
            "instruction": { "type": "string" },
            "dependencyBarrier": { "type": "string" }
          }
        },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issue",
            "instruction"
          ],
          "properties": {
            "issue": { "type": "string" },
            "instruction": { "type": "string" }
          }
        }
      }
    },
    "digestAlgorithm": {
      "const": "sha256-rfc8785-v1"
    },
    "receiptDigest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "semver": {
      "type": "string",
      "minLength": 5,
      "maxLength": 80,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
