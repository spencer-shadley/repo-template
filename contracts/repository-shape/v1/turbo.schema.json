{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-template.dev/repository-shape/v1/turbo.schema.json",
  "title": "TurboTaskGraphV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tasks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/taskDefinition"
      }
    }
  },
  "$defs": {
    "taskDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cache": {
          "type": "boolean"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "persistent": {
          "type": "boolean"
        }
      }
    }
  }
}
