{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-template.dev/overlays/v1/product-overlay.schema.json",
  "title": "Product and platform overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "profile",
    "provenance",
    "platforms"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0", "product-overlay/v1"]
    },
    "contractId": {
      "const": "repo-template/product-overlay-v1"
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/platformRecord"
      }
    }
  },
  "$defs": {
    "role": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "accessory",
        "specialized",
        "dormant",
        "not-targeted"
      ]
    },
    "platformRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "priority",
        "owner",
        "acceptanceSuites"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "acceptanceSuites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string"
        },
        "revisitTrigger": {
          "type": "string"
        },
        "grandfatheredDivergences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bootstrappedFromGuideVersion": {
          "type": "string"
        },
        "lastAuditedAgainstGuideVersion": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateRelease"
      ],
      "properties": {
        "templateRelease": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "semver",
            "releaseDigest"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"
            },
            "semver": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
            },
            "releaseDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "releaseId": {
              "type": "string"
            },
            "receiptDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "bootstrappedFromGuideVersion": {
          "type": "string"
        },
        "lastAuditedAgainstGuideVersion": {
          "type": "string"
        }
      }
    }
  }
}
