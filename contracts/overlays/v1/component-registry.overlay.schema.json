{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-template.dev/overlays/v1/component-registry.overlay.schema.json",
  "title": "Component registry overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "provenance",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0", "component-registry-overlay/v1"]
    },
    "contractId": {
      "const": "repo-template/component-registry-overlay-v1"
    },
    "provenance": {
      "$ref": "./product-overlay.schema.json#/$defs/provenance"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/componentEntry"
      }
    }
  },
  "$defs": {
    "lifecycle": {
      "type": "string",
      "enum": [
        "preferred-default",
        "context-preferred",
        "supported-alternative",
        "candidate",
        "legacy-compatibility",
        "discouraged",
        "prohibited"
      ]
    },
    "componentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalId",
        "lifecycle",
        "priority",
        "rationale"
      ],
      "properties": {
        "logicalId": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "$ref": "#/$defs/lifecycle"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string"
        },
        "selectedVersion": {
          "type": "string"
        }
      }
    }
  }
}
