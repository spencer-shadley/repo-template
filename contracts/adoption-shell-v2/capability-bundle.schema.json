{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-template.dev/adoption-shell-v2/capability-bundle.schema.json",
  "title": "adoption-shell-v2 capability bundle registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "schemaDigest",
    "contractId",
    "digestAlgorithm",
    "registryDigest",
    "bundles"
  ],
  "properties": {
    "schemaId": {
      "const": "https://schemas.repo-template.dev/adoption-shell-v2/capability-bundle.schema.json"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "schemaDigest": {
      "$ref": "#/$defs/sha256"
    },
    "contractId": {
      "const": "repo-template/adoption-shell-v2"
    },
    "digestAlgorithm": {
      "const": "sha256-rfc8785-v1"
    },
    "registryDigest": {
      "$ref": "#/$defs/sha256"
    },
    "bundles": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/bundle"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "minLength": 5,
      "maxLength": 80,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "bundleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9._@()+,=-]+(?:/[A-Za-z0-9._@()+,=-]+)*$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/bundleId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entrypoint",
        "requiredPaths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "entrypoint": {
          "$ref": "#/$defs/path"
        },
        "requiredPaths": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digestAlgorithm",
        "digest",
        "dependencies",
        "artifacts",
        "fixtures",
        "goldens",
        "modes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/bundleId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "digestAlgorithm": {
          "const": "sha256-rfc8785-v1"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "artifacts": {
          "$ref": "#/$defs/paths"
        },
        "fixtures": {
          "$ref": "#/$defs/paths"
        },
        "goldens": {
          "$ref": "#/$defs/paths"
        },
        "modes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/mode"
          }
        }
      }
    },
    "paths": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    }
  }
}
