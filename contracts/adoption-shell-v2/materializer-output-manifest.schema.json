{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-template.dev/adoption-shell-v2/materializer-output-manifest.schema.json",
  "title": "adoption-shell-v2 materializer output manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "schemaDigest",
    "contractId",
    "digestAlgorithm",
    "manifestDigest",
    "releaseDigest",
    "releasePayloadDigest",
    "payloadDigestAlgorithm",
    "outputPayloadDigest",
    "entryCount",
    "selectedBundles",
    "migrationRefs",
    "entries"
  ],
  "properties": {
    "schemaId": {
      "const": "https://schemas.repo-template.dev/adoption-shell-v2/materializer-output-manifest.schema.json"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "schemaDigest": {
      "$ref": "#/$defs/sha256"
    },
    "contractId": {
      "const": "repo-template/adoption-shell-v2"
    },
    "digestAlgorithm": {
      "const": "sha256-rfc8785-v1"
    },
    "manifestDigest": {
      "$ref": "#/$defs/sha256"
    },
    "releaseDigest": {
      "$ref": "#/$defs/sha256"
    },
    "releasePayloadDigest": {
      "$ref": "#/$defs/sha256"
    },
    "payloadDigestAlgorithm": {
      "const": "sha256-framed-path-kind-mode-content-v1"
    },
    "outputPayloadDigest": {
      "$ref": "#/$defs/sha256"
    },
    "entryCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "selectedBundles": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "migrationRefs": {
      "type": "array",
      "maxItems": 0
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "minLength": 5,
      "maxLength": 80,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "bundleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9._@()+,=-]+(?:/[A-Za-z0-9._@()+,=-]+)*$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/bundleId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "mode",
        "contentSha256",
        "role",
        "encoding",
        "bundleId"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "const": "file"
        },
        "mode": {
          "enum": [
            "100644",
            "100755"
          ]
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "enum": [
            "generic-base-text",
            "generic-base-binary",
            "capability-executable",
            "capability-config",
            "capability-fixture",
            "capability-golden"
          ]
        },
        "encoding": {
          "enum": [
            "utf-8",
            "binary"
          ]
        },
        "bundleId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bundleId"
            }
          ]
        }
      }
    }
  }
}
